# Copy to .env (git-ignored) and replace every "change-me" with a locally generated value, e.g.
#   openssl rand -base64 24
# These are DEVELOPMENT values only. Never reuse them anywhere else; production secrets come from
# the secret manager of the deployment environment (decision D-21), never from a file in this repo.

# --- PostgreSQL ---
POSTGRES_DB=medsmarter
POSTGRES_USER=medsmarter
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_PASSWORD=change-me

# --- Host-side endpoints (used when running api/ai on your machine, not in compose) ---
ConnectionStrings__Postgres="Host=localhost;Port=5432;Database=medsmarter;Username=medsmarter;Password=change-me"
Redis__ConnectionString="localhost:6379,password=change-me"
OpenSearch__Uri=http://localhost:9200
Kafka__BootstrapServers=localhost:29092

# --- AI service (Python) ---
AI_OPENSEARCH_URI=http://localhost:9200
AI_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# LLM provider/model are UNKNOWN (decision D-17): intentionally no LLM settings in Phase 1.

# --- Web (build-time) ---
VITE_API_BASE_URL=http://localhost:5080

# --- Authentication (Phase 3) ---
# DevelopmentMock = fictional demo accounts, NO passwords. The API REFUSES to start with it unless ASPNETCORE_ENVIRONMENT is
# Development or Testing. Any other environment must set a real signing key and (later phase) a real identity provider.
Auth__Mode=DevelopmentMock
# Auth__SigningKey=<at least 32 random characters; required outside Development. Empty in Development = random per process>
# Web: VITE_AUTH_MODE=api makes the web app sign in through the API; the default (local) uses in-browser demo accounts.
# VITE_AUTH_MODE=api

# --- Medication knowledge core and AI provider (Phase 4) ---
# Fictional demo medications. The API REFUSES to start with this on outside Development/Testing.
Medications__SeedDemoData=true
# AI provider: Disabled (default) | Mock | External | Local. Mock needs no key and makes no network call; it is refused outside
# Development/Testing unless Ai__AllowMockInProduction=true. Nothing below is a real key: leave empty until a provider is approved.
Ai__Provider=Mock
Ai__BaseUrl=
Ai__ApiKey=
Ai__Model=
Ai__TimeoutSeconds=20
Ai__MaxTokens=512
# Sending questions to an external provider must be approved explicitly (default false).
Ai__AllowExternalDataTransfer=false
# Fictional insurer used to exercise the integration contracts (never a real connection).
Integrations__Insurance__EnableMock=true
# Per-caller rate limits (requests per minute, per API instance).
RateLimits__SearchPerMinute=120
RateLimits__AiPerMinute=20
RateLimits__WritePerMinute=60

# --- Patient records, batches, manufacturer reports, guidance (Phase 5) ---
# Persistence: Postgres (default, needs ConnectionStrings__Postgres) | InMemory (ONLY Development/Testing; refused elsewhere).
Persistence__Provider=Postgres
# Apply EF migrations at start-up (development only; elsewhere run the migrator on purpose).
Persistence__MigrateOnStartup=true
# Fictional DEMO patients, batches, reports and guidance messages. The API REFUSES to start with these on outside Development/Testing.
Patients__SeedDemoData=true
ManufacturerReports__SeedDemoData=true
Guidance__SeedDemoData=true
# Manufacturer reports: Mock only. There is NO real manufacturer channel; real sending needs a signed agreement per manufacturer.
ManufacturerReports__Provider=Mock
# Secret used to hash external patient identifiers (empty = the feature refuses to link identifiers). Generate locally, never commit.
Patients__IdentifierHashKey=

# --- AI assistant (Phase 6) ---
# External AI is OFF unless ALL of these hold: Ai__Provider=External, Ai__AllowExternalDataTransfer=true, an https (or loopback) Ai__BaseUrl, a key, a model,
# AND the signed-in person has given the AiExternalProcessing consent. Missing any one fails closed: nothing is sent. Keys come only from the environment.
# Sources received longer ago than this are flagged "may be out of date" in answers (not a clinical validity period).
Ai__EvidenceStaleAfterDays=1095
